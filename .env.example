# Copy to .env, replace every value, and keep .env out of Git.
MACHINEGUARD_DB_PASSWORD=replace-with-a-random-local-password
IAM_JWT_SECRET=replace-with-at-least-32-random-bytes
IAM_ACCESS_TOKEN_TTL_SECONDS=900
IAM_REFRESH_TOKEN_TTL_DAYS=30
API_PORT=8080
POSTGRES_PORT=5432
CORE_MAX_FUTURE_SECONDS=60
CORE_MAX_READING_AGE_DAYS=30
CORE_MIN_RECORDED_AT=2026-01-01T00:00:00Z
CORE_FRESHNESS_MINIMUM_SECONDS=30
CORE_FRESHNESS_INTERVAL_MULTIPLIER=3
CORE_OPENAPI_ENABLED=false
SERVER_ADDRESS=127.0.0.1
IAM_LOGIN_LIMIT=5
IAM_LOGIN_WINDOW_SECONDS=60
IAM_LOGIN_MAX_KEYS=10000

# Optional one-time bootstrap. Set enabled=true and provide all four values on
# the first run only; the database records completion and ignores later changes.
IAM_BOOTSTRAP_ENABLED=false
IAM_BOOTSTRAP_ORGANIZATION_NAME=
IAM_BOOTSTRAP_ADMIN_NAME=
IAM_BOOTSTRAP_ADMIN_EMAIL=machineguard@demo.com
IAM_BOOTSTRAP_ADMIN_PASSWORD=

# Optional read-only user created by scripts/demo_data.py seed (password: 12+ characters).
MG_VIEWER_EMAIL=user@demo.com
MG_VIEWER_PASSWORD=
